{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node"],
		"strict": true,
		"noImplicitReturns": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts",
		"scripts/**/*.ts",
		"vitest.config.mts",
		"vitest.obsidian.config.mts",
		"esbuild.config.d.mts"
	]
}
