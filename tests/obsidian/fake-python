#!/bin/bash
# Stands in for the engine's Python in the tests against real Obsidian: it
# answers the plugin's check (src/engine.ts) as an installed engine without the
# faster one, and runs the fake server as `python -I -u -m edge_voice_engine`.
case "$*" in
	*"from edge_voice_engine.server import PROTOCOL, VERSION"*)
		echo '{"version": "0.2.0", "protocol": 1, "faster": false}'
		exit 0
		;;
	"-I -u -m edge_voice_engine") exec /usr/bin/env python3 -u "$(dirname "$0")/../fixtures/fake_server.py" ;;
esac
echo "fake-python: unexpected arguments: $*" >&2
exit 2
