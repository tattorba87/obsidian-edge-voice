{
	"name": "obsidian-edge-voice",
	"version": "0.1.0",
	"private": true,
	"description": "Obsidian plugin that reads notes and PDFs aloud with on-device Moonshine TTS.",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "tsc --noEmit && bun esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write . && uvx ruff@0.14.3 format server.py tests/python",
		"format:check": "prettier --check . && uvx ruff@0.14.3 format --check server.py tests/python",
		"test": "vitest run",
		"test:python": "uv run --with pytest==8.4.2 pytest",
		"test:obsidian": "vitest run --config vitest.obsidian.config.mts",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run test:python",
		"sandbox": "bun scripts/sandbox/main.ts",
		"sandbox:reset": "bun scripts/sandbox/main.ts reset",
		"sandbox:errors": "bun scripts/sandbox/main.ts errors",
		"release": "bun scripts/version-bump.mjs",
		"prepare": "lefthook install || true"
	},
	"license": "MIT",
	"packageManager": "bun@1.4.3",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "9.39.5",
		"@eslint/json": "0.14.0",
		"@types/node": "24.10.1",
		"builtin-modules": "5.0.0",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"happy-dom": "21.0.3",
		"lefthook": "2.2.2",
		"obsidian": "1.14.4",
		"pdf-lib": "1.17.1",
		"pdfjs-dist": "4.10.38",
		"prettier": "3.9.10",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.2",
		"vitest": "4.1.12"
	}
}
